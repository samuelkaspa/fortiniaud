{
  "name": "fortiniaud",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "Game" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],
  "vars": {
    // Opcional: Client ID do Google (xxxx.apps.googleusercontent.com) para ativar login com Google
    "GOOGLE_CLIENT_ID": ""
  },
  "observability": { "enabled": true }
}
